# ---------------------------------------------------------------
# Plantilla de variables de entorno.
# Copia este archivo a .env y rellena los valores.
# NUNCA subas el archivo .env al repositorio.
# ---------------------------------------------------------------

# Token del bot de Telegram (BotFather)
TELEGRAM_BOT_TOKEN=

# API key de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo a utilizar
ANTHROPIC_MODEL=

# Correo al que se derivan las reclamaciones
SUPPORT_EMAIL=
